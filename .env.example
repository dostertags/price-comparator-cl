# Todas las variables son OPCIONALES. El comparador no necesita cuentas ni claves.
# Copia este archivo a .env si quieres cambiar algún valor (no lo subas a git).

# User-Agent que se envía a las tiendas (uno solo, sin rotación)
PC_USER_AGENT=Mozilla/5.0 (compatible; price-comparator-cl/0.1; uso personal)
# Segundos máximos por request
PC_TIMEOUT_S=15
# Reintentos por request
PC_MAX_RETRIES=3
# Pausa cortés entre requests a una misma tienda (segundos, mín y máx)
PC_DELAY_MIN_S=1.2
PC_DELAY_MAX_S=3.0
# Ofertas máximas por tienda y producto
PC_MAX_OFFERS_PER_STORE=15
# Productos buscados en paralelo (máx. 8)
PC_WORKERS=4
# Coincidencia mínima (0-1) para que una oferta pueda ganar
PC_MIN_SCORE=0.60
# Rango de precios considerado realista (CLP)
PC_PRICE_MIN_CLP=500
PC_PRICE_MAX_CLP=50000000
# http | headless
PC_MODE=http
# DEBUG | INFO | WARNING | ERROR
PC_LOG_LEVEL=INFO
